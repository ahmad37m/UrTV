<?xml version="1.0" encoding="utf-8"?>
<!-- Home screen adapted from github.com/mihirgupta0900/tv-home (MIT). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="sa.urtv.screensaver.READ_CONFIG" />
    <uses-permission android:name="sa.urtv.screensaver.WRITE_TASKS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <permission
        android:name="sa.urtv.home.READ_NOW_PLAYING"
        android:protectionLevel="signature" />

    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
        <package android:name="com.tcl.tv" />
        <package android:name="com.tcl.suspension" />
        <package android:name="sa.urtv.screensaver" />
        <package android:name="com.google.android.apps.tv.launcherx" />
        <package android:name="com.google.android.tvlauncher" />
        <package android:name="com.google.android.leanbacklauncher" />
    </queries>

    <application
        android:label="تلفزيونك"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/banner"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Home">

        <!-- Main TV home activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:windowSoftInputMode="adjustNothing"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode|density">

            <!-- Keep HOME functionality -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!-- Make the app visible in Android TV app lists -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>

            <!-- Also support ordinary Android app lists -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".DockActivity"
            android:exported="true"
            android:label="ترتيب المفضلة"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.Material.NoActionBar" />

        <activity
            android:name=".TasksActivity"
            android:exported="true"
            android:label="المهام"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.Material.NoActionBar" />

        <receiver
            android:name=".DockReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="sa.urtv.home.GET_DOCK" />
                <action android:name="sa.urtv.home.LIST_APPS" />
                <action android:name="sa.urtv.home.SET_DOCK" />
                <action android:name="sa.urtv.home.RESET_DOCK" />
                <action android:name="sa.urtv.home.HIDDEN" />
                <action android:name="sa.urtv.home.HIDE" />
                <action android:name="sa.urtv.home.SHOW" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".SleepReceiver"
            android:exported="false" />

        <service
            android:name=".SleepService"
            android:exported="true"
            android:label="@string/sleep_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/sleep_service" />
        </service>

        <activity
            android:name=".tilawah.MainActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="landscape"
            android:theme="@style/App"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode|density" />

        <activity
            android:name=".tilawah.SurahActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/App"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode|density" />

        <activity
            android:name=".tilawah.PlayerActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="landscape"
            android:theme="@style/App"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode|density" />

        <activity
            android:name=".tilawah.AdhanActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/App"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode|density" />

        <service
            android:name=".tilawah.MusicService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <receiver
            android:name=".tilawah.MusicReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="sa.urtv.home.GET_PLAYER" />
                <action android:name="sa.urtv.home.PLAY_SURAH" />
                <action android:name="sa.urtv.home.PLAY_RADIO" />
                <action android:name="sa.urtv.home.PAUSE" />
                <action android:name="sa.urtv.home.RESUME" />
                <action android:name="sa.urtv.home.TOGGLE" />
                <action android:name="sa.urtv.home.NEXT" />
                <action android:name="sa.urtv.home.PREV" />
                <action android:name="sa.urtv.home.STOP" />
                <action android:name="sa.urtv.home.SLEEP" />
                <action android:name="sa.urtv.home.SEEK_BY" />
                <action android:name="sa.urtv.home.ADHAN" />
                <action android:name="sa.urtv.home.ADHAN_VOLUME" />
                <action android:name="sa.urtv.home.ADHAN_RESCHEDULE" />
                <action android:name="sa.urtv.home.ADHAN_ON" />
                <action android:name="sa.urtv.home.ADHAN_OFF" />
                <action android:name="sa.urtv.home.VOICE" />
                <action android:name="sa.urtv.home.ADHAN_OWN" />
            </intent-filter>
        </receiver>

        <provider
            android:name=".tilawah.NowPlayingProvider"
            android:authorities="sa.urtv.home.nowplaying"
            android:exported="true"
            android:readPermission="sa.urtv.home.READ_NOW_PLAYING" />

        <provider
            android:name=".tilawah.OwnAdhanProvider"
            android:authorities="sa.urtv.home.adhan"
            android:exported="true"
            android:permission="android.permission.DUMP" />

        <receiver
            android:name=".tilawah.AdhanReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
